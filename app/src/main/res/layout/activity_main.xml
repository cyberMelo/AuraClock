<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_black"
    android:keepScreenOn="true">

    <!-- ================================================================= -->
    <!-- LAYER 1: Android WebView (Living Weather Horizon / Lovelace)      -->
    <!-- ================================================================= -->
    <WebView
        android:id="@+id/webViewLivingHorizon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <!-- ================================================================= -->
    <!-- LAYER 2: Night & Offline Native Overlay (Nero puro + Ambra Caldo) -->
    <!-- ================================================================= -->
    <FrameLayout
        android:id="@+id/layerNightOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/night_black"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/nightContentContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Badge Sveglia Prossima (es. 🔔 07:30) -->
            <TextView
                android:id="@+id/tvNightAlarmBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.85"
                android:letterSpacing="0.08"
                android:textColor="@color/amber_warm_red"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="🔔 07:30" />

            <!-- Orologio Notturno 24h a caratteri giganti -->
            <TextClock
                android:id="@+id/tcNightClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.70"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:letterSpacing="-0.04"
                android:textColor="@color/amber_primary"
                android:textSize="138sp"
                android:textStyle="bold"
                tools:text="23:45" />

            <!-- Temperatura Esterna Cache HA -->
            <TextView
                android:id="@+id/tvNightExternalTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:alpha="0.65"
                android:textColor="@color/amber_secondary"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:text="11.2°C" />

            <!-- Avviso Offline (visibile solo se HA è irraggiungibile) -->
            <TextView
                android:id="@+id/tvNightOfflineStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#26DC2626"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="Offline • Sveglia Locale Attiva"
                android:textColor="#EF4444"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- ================================================================= -->
    <!-- LAYER 3: Alarm Ringing Native UI (Proposta A: Aura Sunrise Dock)  -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/layerAlarmRinging"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_alarm_sunrise_radial"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="22dp"
        android:paddingEnd="28dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Top Header: Badge Sveglia & Temp Esterna -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/llAlarmHeaderBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:background="@drawable/bg_alarm_badge_ringing"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔔 SVEGLIA IN CORSO"
                    android:textColor="#FDE68A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAlarmExtTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_alarm_badge_temp"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="🌡️ 14.5°C" />
        </RelativeLayout>

        <!-- Centro: Orologio Gigante con Alone Caldo d'Alba -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAlarmRingingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="-0.05"
                android:shadowColor="#80F59E0B"
                android:shadowDx="0"
                android:shadowDy="10"
                android:shadowRadius="35"
                android:textColor="#FFFFFF"
                android:textSize="142sp"
                android:textStyle="bold"
                tools:text="07:30" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:alpha="0.85"
                android:letterSpacing="0.12"
                android:text="SVEGLIA COMODINO • SVEGLIATI DOLCEMENTE"
                android:textColor="#FED7AA"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Basso: Dock Comandi Satinati (Snooze + Stop) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:orientation="horizontal">

                <!-- SNOOZE CARD (Grande, Ambra Caldo) -->
                <FrameLayout
                    android:id="@+id/btnAlarmSnooze"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1.35"
                    android:background="@drawable/bg_alarm_pill_amber"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="22dp"
                    android:paddingEnd="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|start"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SNOOZE"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+10 Minuti di Riposo"
                            android:textColor="#FEF3C7"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_vertical|end"
                        android:background="@drawable/bg_circle_icon_amber"
                        android:gravity="center"
                        android:text="💤"
                        android:textSize="22sp" />
                </FrameLayout>

                <!-- STOP CARD (Vetro Scuro Satinato + Contorno Corallo) -->
                <FrameLayout
                    android:id="@+id/btnAlarmStop"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.0"
                    android:background="@drawable/bg_alarm_pill_stop"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="18dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|start"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STOP SVEGLIA"
                            android:textColor="#F87171"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Spegni per oggi"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical|end"
                        android:background="@drawable/bg_circle_icon_stop"
                        android:gravity="center"
                        android:text="🛑"
                        android:textSize="16sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- Hint Tasti Fisici -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:text="OPPURE PREMI VOL PER SNOOZE • TASTO CENTRALE PER STOP"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================================================================= -->
    <!-- LAYER 4: Settings / Provisioning Overlay (5-tap o primo avvio)    -->
    <!-- ================================================================= -->
    <ScrollView
        android:id="@+id/layerSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/settings_bg"
        android:padding="20dp"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Intestazione -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/settings_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Banner Web Server Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/settings_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvSettingsWebServerInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Web Configurator: http://0.0.0.0:8080"
                    android:textColor="@color/settings_accent"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSettingsDiagnostic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Stato: WS sconosciuto • Lux: --"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Form Rapido HA URL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Home Assistant URL:"
                android:textColor="@color/settings_text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etHaUrl"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@color/settings_card"
                android:hint="@string/ha_url_hint"
                android:inputType="textUri"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/settings_text_primary"
                android:textColorHint="@color/settings_text_secondary"
                android:textSize="14sp" />

            <!-- Form Rapido HA Token -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Long-Lived Access Token:"
                android:textColor="@color/settings_text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etHaToken"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@color/settings_card"
                android:hint="@string/ha_token_hint"
                android:inputType="textPassword"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/settings_text_primary"
                android:textColorHint="@color/settings_text_secondary"
                android:textSize="14sp" />

            <!-- Pulsanti Azione -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/settings_btn_save"
                    android:text="@string/save_btn"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnReloadWebview"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/settings_card"
                    android:text="@string/reload_webview_btn"
                    android:textColor="@color/settings_accent" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnOpenWifiSettings"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/settings_card"
                    android:text="@string/wifi_settings_btn"
                    android:textColor="@color/settings_text_primary" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnCloseSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:backgroundTint="#475569"
                    android:text="CHIUDI"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ================================================================= -->
    <!-- TARGET SEGRETO 5-TAP (Area 120x120 px in alto a sinistra)         -->
    <!-- ================================================================= -->
    <View
        android:id="@+id/viewSecretTapTarget"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|start"
        android:background="#00000000"
        android:clickable="true"
        android:focusable="false" />

</FrameLayout>
